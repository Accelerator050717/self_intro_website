---
import '../styles/global.css';
import '../styles/spectrum.css';
import '../styles/waves-site.css';
import SiteWaves from '../components/waves/SiteWaves';
import '@fontsource-variable/manrope';
import Icon from '../components/Icon.astro';
import { ui, route, alternatePath, mainPages, type Lang } from '../i18n/ui';
import { siteUrl } from '../lib/site';
import { siteContact } from '../data/site-config';
interface Props { lang: Lang; title: string; description: string; page?: string; noindex?: boolean }
const { lang, title, description, page = '', noindex = false } = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname;
const alt = lang === 'en' ? 'zh' : 'en';
const indexable = Boolean(siteUrl) && !noindex;
const canonical = siteUrl ? new URL(pathname, siteUrl).href : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { const saved = localStorage.getItem('ice-theme'); document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
      catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {indexable && <><link rel="canonical" href={canonical!}/><link rel="alternate" hreflang="en" href={`${siteUrl}${alternatePath(pathname,'en')}`}/><link rel="alternate" hreflang="zh" href={`${siteUrl}${alternatePath(pathname,'zh')}`}/><link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternatePath(pathname,'en')}`}/></>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mingyang Yu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={siteUrl ? `${siteUrl}/images/share.png` : '/images/share.png'} />
    {indexable && <meta property="og:url" content={canonical!}/>}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-waves" data-gradient-waves aria-hidden="true">
      <div class="site-waves-fallback">
        <img class="waves-still-light" src="/images/waves/light.webp" alt="" width="1440" height="1000" />
        <img class="waves-still-dark" src="/images/waves/dark.webp" alt="" width="1440" height="1000" />
      </div>
      <SiteWaves client:load />
    </div>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header wrap">
      <a class="brand" href={route(lang)} aria-label={`Mingyang Yu — ${t.home}`}><img src="/favicon.svg" alt="" width="34" height="34"/><span>Mingyang Yu<span class="brand-period">.</span></span></a>
      <nav id="site-nav" class="navigation" aria-label={lang === 'en' ? 'Main navigation' : '主导航'}>
        {mainPages.map(item => <a href={route(lang,item)} aria-current={page === item ? 'page' : undefined}>{t[item]}</a>)}
      </nav>
      <div class="header-tools">
        <a class="language-switch" data-language-switch href={alternatePath(pathname,alt)} lang={alt} aria-label={alt === 'zh' ? '切换到中文' : 'Switch to English'}>{alt === 'zh' ? '中文' : 'EN'}</a>
        <span class="tool-divider" aria-hidden="true"></span>
        <button class="icon-button js-only theme-toggle" aria-label={t.theme} data-light={t.light} data-dark={t.dark}><Icon name="sun" class="sun-icon"/><Icon name="moon" class="moon-icon"/></button>
        <button class="icon-button js-only global-animation-toggle" data-global-pause data-pause-label={t.pause} data-resume-label={t.resumeAnimation} aria-label={t.pause} aria-pressed="false">
          <svg class="motion-pause-icon" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 4v12M13 4v12" /></svg>
          <svg class="motion-resume-icon" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 3 11 7-11 7z" /></svg>
        </button>
        <button class="icon-button menu-toggle js-only" aria-label={t.menu} aria-expanded="false" aria-controls="site-nav" data-open-label={t.menu} data-close-label={t.close}><Icon name="menu" class="menu-icon"/><Icon name="close" class="close-icon"/></button>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="site-footer wrap">
      <div class="footer-top"><a class="brand" href={route(lang)}><img src="/favicon.svg" alt="" width="28" height="28"/><span>Mingyang Yu.</span></a><p>{t.footer}</p><div class="footer-links"><a href={siteContact.mailto}>{lang === 'en' ? 'Email' : '邮箱'} <Icon name="arrow" size={15}/></a><a href={siteContact.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={15}/></a></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {t.rights}</span><span>{t.campus}</span></div>
    </footer>
    <script>
      import { siteContact } from '../data/site-config';
      import { enhanceVisuals } from '../scripts/visual-effects';
      enhanceVisuals();
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      function themeLabel() { if (themeButton) themeButton.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? themeButton.dataset.light! : themeButton.dataset.dark!); }
      themeLabel();
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return;
        try {
          const saved = localStorage.getItem('ice-theme');
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
        } catch { /* Retain the current theme without storage. */ }
        themeLabel(); window.dispatchEvent(new CustomEvent('ice-theme-change'));
      });
      themeButton?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('ice-theme', theme); } catch { /* Current page still updates when storage is blocked. */ }
        themeLabel(); window.dispatchEvent(new CustomEvent('ice-theme-change'));
      });
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      function closeMenu(focus = false) { menu?.setAttribute('aria-expanded','false'); menu?.setAttribute('aria-label',menu.dataset.openLabel!); nav?.removeAttribute('data-open'); if(focus) menu?.focus(); }
      menu?.addEventListener('click', () => {
        if(menu.getAttribute('aria-expanded') === 'true') { closeMenu(); return; }
        menu.setAttribute('aria-expanded','true'); menu.setAttribute('aria-label',menu.dataset.closeLabel!); nav?.setAttribute('data-open','');
      });
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') closeMenu(true); });
      document.addEventListener('click', e => { if (!(e.target as Element).closest('.site-header')) closeMenu(); });
      nav?.addEventListener('click', e => { if((e.target as Element).closest('a')) closeMenu(); });
      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach(button => button.addEventListener('click', async () => {
        const region = button.closest<HTMLElement>('.contact-actions')!;
        const status = region.querySelector<HTMLElement>('[role=status]')!;
        try { if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable'); await navigator.clipboard.writeText(siteContact.email); status.textContent = button.dataset.success!; }
        catch { status.textContent = button.dataset.failure!; const address = region.querySelector<HTMLElement>('[data-email-text]'); if(address) { const range = document.createRange(); range.selectNodeContents(address); const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(range); address.focus(); } }
      }));
      document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
